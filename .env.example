# ==============================================================================
# Cross-Lingual Hindi RAG Engine — Environment Configuration Example
# ==============================================================================

# Gemini LLM Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Multilingual Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Vector Database Storage Path
CHROMA_PERSIST_DIR=storage/chroma_db
COLLECTION_NAME=hindi_rag_kalam

# Local Cache Redirection
HF_HOME=D:/hf_cache
TORCH_HOME=D:/torch_cache

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
